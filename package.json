{
  "name": "vastai-mcp",
  "version": "0.1.0",
  "description": "Vast.ai MCP: let AI agents rent the lowest effective-cost GPU on Vast.ai, deploy MiniMax H3 / LTX-2.5 / ComfyUI / vLLM, and tear the instance down the moment the work is done.",
  "type": "module",
  "bin": {
    "vastai-mcp": "./dist/mcp/index.js",
    "vast-deploy": "./dist/cli/index.js"
  },
  "files": ["dist", "examples", "docs", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:mcp": "tsx src/mcp/index.ts",
    "dev:cli": "tsx src/cli/index.ts",
    "start": "node dist/mcp/index.js",
    "test:mcp": "node scripts/smoke-mcp.mjs",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/mcp/index.js",
    "prepublishOnly": "npm run build"
  },
  "mcpName": "io.github.yowmamasita/vastai-mcp",
  "keywords": ["mcp", "model-context-protocol", "vast.ai", "gpu", "ai-agents", "minimax", "comfyui", "claude", "deploy"],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": { "node": ">=20" }
}
